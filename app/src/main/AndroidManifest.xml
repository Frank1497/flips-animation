<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Razr Fold Scenes"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".PickerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".wallpaper.TestWallpaperService"
            android:exported="true"
            android:label="@string/test_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/test_wallpaper" />
            <!-- Motorola's cover-screen picker lists services carrying this tag (11 of its own do). -->
            <meta-data
                android:name="moto.cli.livewallpaper"
                android:value="true" />
        </service>
    </application>

</manifest>
